---
layout: layouts/base.njk
section: resorts
pagination:
  data: resorts
  size: 1
  addAllPagesToCollections: true
  alias: resort
permalink: "/resorts/{{ resort.slug }}/"
eleventyComputed:
  title: "{{ resort.name if resort.name.length <= 50 else resort.short }}: a first-timer's guide"
  description: "{{ resort.theme }} First-timer's guide to rooms, pools, dining and park transport."
---
{% set tier = tiers | findTierByName(resort.tier) %}
{% set g = resortGuides[resort.slug] or {} %}
<section class="page-hero">
  <div class="wrap page-hero-row">
    <div class="page-hero-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/resorts/">Resorts</a> <span aria-hidden="true">›</span> <a href="/resorts/#walt-disney-world">Walt Disney World</a> <span aria-hidden="true">›</span> <a href="/resorts/#{{ tier.slug }}">{{ tier.plural or tier.name }}</a></nav>
      <p class="eyebrow">{{ resort.tier }} resort · Walt Disney World · {{ resort.area }}</p>
      <h1>{{ resort.name }}</h1>
      <p class="lead">{{ resort.theme }}</p>
      {% include "guide-byline.njk" %}
    </div>
    {% set label = resort.short %}
    <div class="hero-soon">{% include "coming-soon.njk" %}</div>
  </div>
</section>

<div class="wrap guide-row">
  <article class="guide">
    {% if resort.dvc %}
    <div class="callout">
      <strong>This is a Disney Vacation Club resort.</strong>
      <p>You don't need to be a member to stay here. Villas range from studios with a kitchenette to multi-bedroom villas with a full kitchen.{% if resort.host %}{% set host = resorts | findResort(resort.host) %} It shares grounds with <a href="/resorts/{{ host.slug }}/">{{ host.short }}</a>.{% endif %}</p>
    </div>
    {% endif %}

{% include "guide-body.njk" %}
  </article>

  <aside class="guide-side">
    <div class="card facts">
      <h2>At a glance</h2>
      <dl>
        <dt>Category</dt><dd><a href="/resorts/#{{ tier.slug }}">{{ resort.tier }}</a></dd>
        <dt>Area</dt><dd>{{ resort.area }}</dd>
        <dt>Getting around</dt><dd>{{ resort.transport | first }}</dd>
        <dt>Best for</dt>{% if g.bestFor %}<dd>{{ g.bestFor }}</dd>{% else %}<dd class="todo">[BEST FOR]</dd>{% endif %}
        <dt>Facts last checked</dt>{% if g.checked %}<dd>{{ g.checked }}</dd>{% else %}<dd class="todo">[DATE]</dd>{% endif %}
      </dl>
    </div>
    {% set nearby = resorts | byArea(resort.area, resort.slug) %}
    {% if nearby.length %}
    <div class="card nearby">
      <h2>Also in the {{ resort.area | replace(" area", "") }} area</h2>
      <ul>{% for n in nearby %}<li><a href="/resorts/{{ n.slug }}/">{{ n.short }}</a> <small>{{ n.tier }}</small></li>{% endfor %}</ul>
    </div>
    {% endif %}
  </aside>
</div>
