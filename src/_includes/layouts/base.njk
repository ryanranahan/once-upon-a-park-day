<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-QR7PQJGKXN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-QR7PQJGKXN');
</script>
<title>{% if title %}{{ title }} | Once Upon A Park Day{% else %}Once Upon A Park Day | First-timer guides to Disney resorts and cruises{% endif %}</title>
<meta name="description" content="{{ description or 'Plain-English guides to Disney resort hotels, Disney Cruise Line, and trip planning for first-time visitors.' }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#16294F">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>


<header class="site-header" id="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/">
      <img src="/images/logo.svg" alt="Once Upon A Park Day" width="196" height="52">
    </a>
    <form class="search" role="search" action="#">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3F5873" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <label class="sr-only" for="q">Search guides</label>
      <input id="q" type="search" name="q" placeholder="Search a resort, ship, or question">
    </form>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      <a href="/resorts/"{% if section == "resorts" %} aria-current="page"{% endif %}>Resorts</a>
      <a href="#">Cruises</a>
      <a href="#">Planning</a>
      <a href="/blog/"{% if section == "blog" %} aria-current="page"{% endif %}>Blog</a>
      <a class="btn btn-red" href="/#start">Start here</a>
    </nav>
    <div class="header-icons">
      <button class="icon-btn" type="button" id="search-toggle" aria-label="Search" aria-expanded="false"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
      <button class="icon-btn" type="button" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
  <div class="awning" aria-hidden="true"></div>
</header>

<main>
{{ content | safe }}
</main>


<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-top">
      <img src="/images/logo-light.svg" alt="Once Upon A Park Day" width="240" height="64">
      <nav class="footer-nav" aria-label="Footer">
        <a href="/resorts/">Resorts</a>
        <a href="/blog/">Blog</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
        <a href="#">Privacy policy</a>
        <a href="#">Affiliate disclosure</a>
      </nav>
    </div>
    <p>Once Upon A Park Day is an independent site. It is not affiliated with, endorsed by, or sponsored by The Walt Disney Company. Some links are affiliate links, which means we may earn a commission at no extra cost to you.</p>
  </div>
</footer>

<nav class="tabbar" aria-label="Quick navigation">
  <a href="/"{% if section == "home" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/></svg>Home</a>
  <a href="/resorts/"{% if section == "resorts" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M5 20V9l7-5 7 5v11M10 20v-6h4v6"/></svg>Resorts</a>
  <a href="#"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15h18l-2 5H5zM6 15V9h12v6M10 9V5h4v4"/></svg>Cruises</a>
  <a href="/blog/"{% if section == "blog" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h11l3 3v13H5z"/><path d="M9 10h6M9 14h6M9 18h3"/></svg>Blog</a>
</nav>

<script>
(function () {
  var header = document.getElementById('site-header');
  var menuBtn = document.getElementById('menu-toggle');
  var searchBtn = document.getElementById('search-toggle');
  menuBtn.addEventListener('click', function () {
    var open = header.classList.toggle('open');
    header.classList.remove('search-open');
    menuBtn.setAttribute('aria-expanded', open);
    searchBtn.setAttribute('aria-expanded', false);
  });
  searchBtn.addEventListener('click', function () {
    var open = header.classList.toggle('search-open');
    header.classList.remove('open');
    searchBtn.setAttribute('aria-expanded', open);
    menuBtn.setAttribute('aria-expanded', false);
    if (open) { document.getElementById('q').focus(); }
  });
  // Placeholder behaviour until the finder and the email service are built.
  var finder = document.getElementById('finder');
  if (finder) finder.addEventListener('submit', function (e) {
    e.preventDefault();
    document.getElementById('finder-note').textContent = 'Matches will appear here once the resort guides are published.';
  });
  var signup = document.getElementById('signup-form');
  if (signup) signup.addEventListener('submit', function (e) { e.preventDefault(); });
})();
</script>
</body>
</html>
