<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-QR7PQJGKXN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-QR7PQJGKXN');
</script>
{% set metaTitle = title | pageTitle(site.name, site.name + ": Disney resort and cruise guides for first-timers") -%}
{%- set metaDesc = (description or site.description) | metaDescription -%}
{%- set canonical = site.url + page.url -%}
{%- set guide = (resortGuides[resort.slug] if (resort and section == "resorts") else (resort.guide if resort else ship)) or {} -%}
{%- set photoPrefix = "dl" if page.url.startsWith("/disneyland/") else ("uo" if page.url.startsWith("/universal-orlando/") else "wdw") -%}
{%- set heroPhoto = (ship.photo or photos["ship/" + ship.slug]) if ship else ((resort.photo or photos[photoPrefix + "/" + resort.slug]) if resort else (photos[photo] if (photo and photo.length) else null)) -%}
{%- set shareImage = ogImage or image or heroSrc or (heroPhoto.src if heroPhoto else site.ogImage) -%}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc }}">
{% if noindex %}<meta name="robots" content="noindex">
{% else %}<link rel="canonical" href="{{ canonical }}">
{% endif %}<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'article' if (resort or ship or category or isArticle) else 'website' }}">
<meta property="og:title" content="{{ (title or site.name) | plainText }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.url }}{{ shareImage }}">
<meta property="og:locale" content="en_US">
{% if "/blog/posts/" in page.inputPath %}<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:author" content="{{ author or 'Ryan' }}">
{% if category %}<meta property="article:section" content="{{ category }}">
{% endif %}{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ (title or site.name) | plainText }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ site.url }}{{ shareImage }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<meta name="theme-color" content="#16294F">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap"></noscript>
<link rel="stylesheet" href="/css/site.css">
{% if not noindex %}<script type="application/ld+json">{{ {
  site: site, url: page.url, title: title, description: metaDesc, section: section,
  resort: resort, ship: ship, guide: guide, author: author, isArticle: isArticle, faq: faq, checked: checked, guideUpdated: guideUpdated,
  isPost: ("/blog/posts/" in page.inputPath), date: (page.date | isoDate),
  updated: (updated | isoDate if updated else undefined), category: category, keywords: keywords,
  about: about, sources: sources, tldr: tldr, image: (ogImage or image or heroSrc or shareImage), photo: photo, photos: photos, heroSrc: heroSrc,
  resorts: resorts, disneyland: disneyland, universal: universal, ships: ships, posts: collections.post
} | jsonLd | safe }}</script>{% endif %}
</head>
<body>


<header class="site-header" id="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/">
      <img src="/images/logo.svg" alt="Once Upon A Park Day" width="196" height="52">
    </a>
    <form class="search" role="search" action="#">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3F5873" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <label class="sr-only" for="q">Search guides</label>
      <input id="q" type="search" name="q" placeholder="Search a resort, ship, or question">
    </form>
    <nav class="main-nav" id="main-nav" aria-label="Main">
      {% include "resorts-menu.njk" %}
      <a href="/cruises/"{% if section == "cruises" %} aria-current="page"{% endif %}>Disney Cruise Line</a>
      <a href="/planning/"{% if section == "planning" %} aria-current="page"{% endif %}>Planning</a>
      <a href="/blog/"{% if section == "blog" %} aria-current="page"{% endif %}>Blog</a>
      <a class="btn btn-red" href="/#start">Start here</a>
    </nav>
    <div class="header-icons">
      <button class="icon-btn" type="button" id="search-toggle" aria-label="Search" aria-expanded="false"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
      <button class="icon-btn" type="button" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
  <div class="awning" aria-hidden="true"></div>
</header>

<main>
{{ content | safe }}
</main>


<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-top">
      <img src="/images/logo-light.svg" alt="Once Upon A Park Day" width="240" height="64">
      <nav class="footer-nav" aria-label="Footer">
        <a href="/resorts/">Walt Disney World</a>
        <a href="/disneyland/">Disneyland Resort</a>
        <a href="/universal-orlando/">Universal Orlando</a>
        <a href="/cruises/">Disney Cruise Line</a>
        <a href="/blog/">Blog</a>
        <a href="/about/how-we-research/">About</a>
        <a href="/about/photo-credits/">Photo credits</a>
        <a href="#">Contact</a>
        <a href="#">Privacy policy</a>
        <a href="#">Affiliate disclosure</a>
      </nav>
    </div>
    <p>Once Upon A Park Day is an independent site. It is not affiliated with, endorsed by, or sponsored by The Walt Disney Company or Universal Orlando Resort. Some links are affiliate links, which means we may earn a commission at no extra cost to you.</p>
  </div>
</footer>

<nav class="tabbar" aria-label="Quick navigation">
  <a href="/"{% if section == "home" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/></svg>Home</a>
  <a href="/resorts/"{% if section in ["resorts","disneyland","universal"] %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M5 20V9l7-5 7 5v11M10 20v-6h4v6"/></svg>Resorts</a>
  <a href="/cruises/"{% if section == "cruises" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15h18l-2 5H5zM6 15V9h12v6M10 9V5h4v4"/></svg>Cruise Line</a>
  <a href="/blog/"{% if section == "blog" %} aria-current="page"{% endif %}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h11l3 3v13H5z"/><path d="M9 10h6M9 14h6M9 18h3"/></svg>Blog</a>
</nav>

<script>
(function () {
  var header = document.getElementById('site-header');
  var menuBtn = document.getElementById('menu-toggle');
  var searchBtn = document.getElementById('search-toggle');
  menuBtn.addEventListener('click', function () {
    var open = header.classList.toggle('open');
    header.classList.remove('search-open');
    menuBtn.setAttribute('aria-expanded', open);
    searchBtn.setAttribute('aria-expanded', false);
  });
  searchBtn.addEventListener('click', function () {
    var open = header.classList.toggle('search-open');
    header.classList.remove('open');
    searchBtn.setAttribute('aria-expanded', open);
    menuBtn.setAttribute('aria-expanded', false);
    if (open) { document.getElementById('q').focus(); }
  });
  var drop = document.getElementById('resorts-drop');
  var dropBtn = document.getElementById('resorts-btn');
  function setDrop(open) { drop.classList.toggle('open', open); dropBtn.setAttribute('aria-expanded', open); }
  dropBtn.addEventListener('click', function (e) { e.stopPropagation(); setDrop(!drop.classList.contains('open')); });
  document.addEventListener('click', function (e) { if (!drop.contains(e.target)) setDrop(false); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && drop.classList.contains('open')) { setDrop(false); dropBtn.focus(); } });
  // Placeholder behaviour until the finder and the email service are built.
  var finder = document.getElementById('finder');
  if (finder) finder.addEventListener('submit', function (e) {
    e.preventDefault();
    document.getElementById('finder-note').textContent = 'Matches will appear here once the resort guides are published.';
  });
  var signup = document.getElementById('signup-form');
  if (signup) signup.addEventListener('submit', function (e) { e.preventDefault(); });
})();
</script>
</body>
</html>
