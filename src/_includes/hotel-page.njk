{% set tier = dest.tiers | findTierByName(resort.tier) %}
{% set g = resort.guide or {} %}
<section class="page-hero">
  <div class="wrap page-hero-row">
    <div class="page-hero-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/resorts/">Resorts</a> <span aria-hidden="true">›</span> <a href="{{ dest.url }}">{{ dest.name }}</a> <span aria-hidden="true">›</span> <a href="{{ dest.url }}#{{ tier.slug }}">{{ tier.plural or tier.name }}</a></nav>
      <p class="eyebrow">{{ resort.tier }} · {{ dest.name }}</p>
      <h1>{{ resort.name }}</h1>
      <p class="lead">{{ resort.theme }}</p>
      {% include "guide-byline.njk" %}
    </div>
    {% set label = resort.short %}
    {% set photo = resort.photo or photos[dest.photoKey + "/" + resort.slug] %}
    {% include "hero-media.njk" %}
  </div>
</section>

<div class="wrap guide-row">
  <article class="guide">
    {% if g.perks %}
    <div class="callout">
      <strong>Extra perks at this hotel</strong>
      <ul class="ticks">{% for p in g.perks %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% if resort.dvc %}
    <div class="callout">
      <strong>This is a Disney Vacation Club property.</strong>
      <p>Disney says these rooms can be booked by all guests, not just members.</p>
    </div>
    {% endif %}
{% include "guide-body.njk" %}
{% include "quick-answers.njk" %}
  </article>

  <aside class="guide-side">
    <div class="card facts">
      <h2>At a glance</h2>
      <dl>
        <dt>Category</dt><dd><a href="{{ dest.url }}#{{ tier.slug }}">{{ resort.tier }}</a></dd>
        <dt>Destination</dt><dd><a href="{{ dest.url }}">{{ dest.name }}</a></dd>
        <dt>Getting around</dt><dd>{{ resort.transport | first }}</dd>
        <dt>Best for</dt>{% if g.bestFor %}<dd>{{ g.bestFor }}</dd>{% else %}<dd class="todo">[BEST FOR]</dd>{% endif %}
        {% if g.checked %}<dt>Facts last checked</dt><dd>{{ g.checked }}</dd>{% elif guideUpdated %}<dt>Last updated</dt><dd><time datetime="{{ guideUpdated.iso }}">{{ guideUpdated.month }}</time></dd>{% endif %}
      </dl>
    </div>
    <div class="card nearby">
      <h2>Other {{ dest.short }} hotels</h2>
      <ul>{% for n in dest.hotels %}{% if n.slug != resort.slug %}<li><a href="{{ dest.url }}hotels/{{ n.slug }}/">{{ n.short }}</a> <small>{{ n.tier }}</small></li>{% endif %}{% endfor %}</ul>
    </div>
  </aside>
</div>
