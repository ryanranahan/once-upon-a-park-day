<section class="page-hero">
  <div class="wrap page-hero-row">
    <div class="page-hero-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/resorts/">Resorts</a> <span aria-hidden="true">›</span> {{ dest.name }}</nav>
      <p class="eyebrow">{{ dest.where }}</p>
      <h1>{{ dest.name }} hotels, explained</h1>
      <p class="lead">{{ dest.lead }}</p>
    </div>
  </div>
</section>

<div class="wrap">
  {% for t in dest.tiers %}
  <section class="section tier" id="{{ t.slug }}">
    <h2>{{ t.plural or t.name }}</h2>
    <p class="tier-blurb">{{ t.blurb }}</p>
    <div class="grid-3">
      {% for r in dest.hotels | byTier(t.name) %}
      <a class="card resort-card" href="{{ dest.url }}hotels/{{ r.slug }}/">
        <span class="eyebrow">{{ r.tier }}</span>
        <strong>{{ r.short }}</strong>
        <small>{{ r.theme }}</small>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  <section class="section">
    <h2>What every hotel guest gets</h2>
    <ul class="ticks benefits">
      {% for b in dest.benefits %}<li>{{ b }}</li>
      {% endfor %}
    </ul>
    <p class="callout callout-soft">{{ dest.benefitsNote }}</p>
  </section>

  <p class="fineprint">{{ dest.fineprint }}</p>
</div>
