<section class="hero">
  <div class="hero-photo">
    <img src="/images/home/hero.webp" alt="Night view across the lagoon at Disney Springs, with lights reflecting on the water and a balloon glowing above the shoreline." width="2000" height="1334">
  </div>
  <div class="wrap hero-row">
    <div class="hero-copy">
      <p class="eyebrow">First trip? You are in the right place</p>
      <h1>Find the Disney resort or cruise that <em>fits your family.</em></h1>
      <p class="lead">Answer three questions and get a short list, with plain-English guides for each pick.</p>
      <a class="btn btn-outline-light" href="#">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF"><path d="M8 5v14l11-7z"/></svg>
        Watch the 60-second intro
      </a>
      <p class="byline">Written by [YOUR NAME], who has stayed at [NUMBER] Disney resorts.</p>
    </div>
    <form class="finder" id="finder">
      <h2>Resort finder</h2>
      <div class="field">
        <label for="f-who">Who is going?</label>
        <select id="f-who"><option>Family with young kids</option><option>Family with teens</option><option>Adults only</option><option>Big group</option></select>
      </div>
      <div class="field">
        <label for="f-budget">What is your budget?</label>
        <select id="f-budget"><option>Keeping it low</option><option>Middle of the road</option><option>Ready to splurge</option></select>
      </div>
      <div class="field">
        <label for="f-matters">What matters most?</label>
        <select id="f-matters"><option>Close to the parks</option><option>A great pool</option><option>Quiet and relaxing</option><option>Easy transportation</option></select>
      </div>
      <button class="btn btn-yellow" type="submit">Show my matches</button>
      <p class="finder-note" id="finder-note" role="status"></p>
    </form>
  </div>
</section>

