<style>
  :root {
    --navy: #16294F; --navy-deep: #0C1A36; --navy-soft: #24407A;
    --coral: #EE7B6F; --gold: #C9A24A; --gold-soft: #F6ECD3;
    --cream: #FBF8F3; --muted: #4A5570; --link: #B8483C;
    --display: "Playfair Display", Georgia, serif;
    --body: "Nunito", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    min-height: 100vh; min-height: 100svh;
    background: radial-gradient(120% 80% at 50% 0%, #2A4A86 0%, var(--navy) 45%, var(--navy-deep) 100%);
    background-color: var(--navy);
    color: #fff; font-family: var(--body); line-height: 1.55;
    overflow-x: hidden; display: flex; flex-direction: column;
  }
  .awning {
    height: 14px; flex: none; position: relative; z-index: 3;
    background: repeating-linear-gradient(90deg, var(--coral) 0 28px, #fff 28px 56px, var(--gold) 56px 84px, #fff 84px 112px);
  }
  .awning::after {
    content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 10px;
    background: radial-gradient(circle at 14px 0, var(--coral) 9px, transparent 10px) 0 0 / 56px 10px repeat-x,
                radial-gradient(circle at 14px 0, var(--gold) 9px, transparent 10px) 28px 0 / 56px 10px repeat-x;
  }
  #sky { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; cursor: crosshair; }
  .page {
    position: relative; z-index: 2; flex: 1; width: 100%; max-width: 760px; margin: 0 auto;
    padding: 44px 20px 0; text-align: center; pointer-events: none;
    display: flex; flex-direction: column; align-items: center;
  }
  .page a, .page button, .book { pointer-events: auto; }
  .logo { width: min(300px, 78vw); height: auto; display: block; margin: 0 auto 34px; filter: drop-shadow(0 4px 18px rgba(0,0,0,.35)); }
  .sparkle { width: 46px; height: 46px; display: block; margin: 0 auto 14px; animation: spin 9s linear infinite, glow 2.6s ease-in-out infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes glow { 50% { filter: drop-shadow(0 0 12px rgba(201,162,74,.9)); } }
  .eyebrow { margin: 0 0 10px; color: var(--gold); font-weight: 700; font-size: .82rem; letter-spacing: .2em; text-transform: uppercase; }
  h1 {
    margin: 0 0 18px; font-family: var(--display); font-weight: 700;
    font-size: clamp(2.3rem, 7vw, 4.1rem); line-height: 1.08; letter-spacing: -.01em;
    text-shadow: 0 4px 30px rgba(0,0,0,.35);
  }
  h1 em { font-style: italic; font-weight: 600; color: var(--coral); white-space: nowrap; }
  .lead { margin: 0 auto 34px; max-width: 34em; font-size: 1.12rem; color: rgba(255,255,255,.86); }
  .lead strong { color: #fff; }

  /* Storybook "table of contents" card */
  .book {
    position: relative; width: 100%; max-width: 520px; margin: 0 auto 26px; text-align: left;
    background: var(--cream); color: var(--navy); border-radius: 22px; padding: 26px 26px 22px;
    box-shadow: 10px 10px 0 var(--coral), 0 24px 60px rgba(0,0,0,.35);
    transform: rotate(-1deg);
  }
  .book::before {
    content: ""; position: absolute; inset: 9px; border: 1.5px dashed #E8DFD0; border-radius: 16px; pointer-events: none;
  }
  .book h2 { margin: 0 0 4px; font-family: var(--display); font-size: 1.35rem; font-weight: 700; text-align: center; }
  .book .sub { margin: 0 0 16px; text-align: center; color: var(--link); font-size: .74rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li { display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 10px; padding: 9px 0; }
  .toc li + li { border-top: 1px solid #EFE7DA; }
  .toc .ch { font-family: var(--display); font-weight: 700; color: var(--gold); font-size: 1.05rem; min-width: 1.6em; }
  .toc .t { font-weight: 700; display: block; }
  .toc .d { display: block; color: var(--muted); font-size: .9rem; line-height: 1.4; }
  .toc .st {
    font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap;
    color: var(--navy); background: var(--gold-soft); border-radius: 999px; padding: 3px 10px;
  }
  .hint { margin: 10px 0 0; color: rgba(255,255,255,.72); font-size: .95rem; }
  .hint b { color: var(--gold); font-weight: 700; }
  .wishes { min-height: 1.6em; margin: 4px 0 0; color: var(--gold-soft); font-family: var(--display); font-style: italic; font-size: 1.05rem; opacity: 0; transition: opacity .4s; }
  .wishes.on { opacity: 1; }

  .hills { position: relative; z-index: 1; width: 100%; height: 120px; margin-top: 26px; flex: none; pointer-events: none; }
  .hills svg { position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; }
  footer {
    position: relative; z-index: 2; flex: none; background: var(--navy-deep);
    color: rgba(255,255,255,.62); font-size: .8rem; text-align: center; padding: 6px 20px 22px;
  }
  footer p { max-width: 640px; margin: 0 auto; }
  footer .sig { font-family: var(--display); font-style: italic; color: rgba(255,255,255,.85); font-size: 1rem; margin-bottom: 8px; }

  .fade { opacity: 0; transform: translateY(14px); animation: rise .9s cubic-bezier(.2,.7,.2,1) forwards; }
  .d1 { animation-delay: .1s } .d2 { animation-delay: .35s } .d3 { animation-delay: .6s } .d4 { animation-delay: .85s } .d5 { animation-delay: 1.1s }
  .book.fade { transform: translateY(14px) rotate(-1deg); }
  @keyframes rise { to { opacity: 1; transform: none; } }
  .book.fade { animation-name: rise-book; }
  @keyframes rise-book { to { opacity: 1; transform: rotate(-1deg); } }

  @media (max-width: 520px) {
    .page { padding-top: 34px; }
    .logo { margin-bottom: 26px; }
    .book { padding: 22px 18px 18px; box-shadow: 7px 7px 0 var(--coral), 0 20px 50px rgba(0,0,0,.35); }
    .toc li { grid-template-columns: auto 1fr; }
    .toc .st { grid-column: 2; justify-self: start; margin-top: 4px; }
    .hills { height: 90px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sparkle { animation: none; }
    .fade, .book.fade { animation: none; opacity: 1; transform: none; }
    .book.fade { transform: rotate(-1deg); }
  }
</style>
</head>
<body>
<div class="awning" aria-hidden="true"></div>
<canvas id="sky" aria-hidden="true"></canvas>

<main class="page">
  <img class="logo fade d1" src="/images/logo-light.svg" alt="Once Upon A Park Day" width="918" height="245">

  <svg class="sparkle fade d2" viewBox="0 0 48 48" aria-hidden="true"><path fill="#C9A24A" d="M24 2c1.6 10.4 5.6 14.4 16 16-10.4 1.6-14.4 5.6-16 16-1.6-10.4-5.6-14.4-16-16 10.4-1.6 14.4-5.6 16-16z"/><path fill="#F6ECD3" d="M38 30c.7 4.3 2.3 6 6.6 6.6-4.3.7-6 2.3-6.6 6.6-.7-4.3-2.3-6-6.6-6.6 4.3-.7 6-2.3 6.6-6.6z"/></svg>
  <p class="eyebrow fade d2">Chapter one is almost written</p>
  <h1 class="fade d3">Something magical is <em>coming soon.</em></h1>
  <p class="lead fade d3">A friendly, plain-English guide to <strong>Disney and Universal resort hotels</strong>, <strong>Disney Cruise Line ships</strong> and planning your very first trip, written from real stays and real sailings.</p>

  <section class="book fade d4" aria-labelledby="toc-title">
    <h2 id="toc-title">Coming in chapter one</h2>
    <p class="sub">The table of contents</p>
    <ol class="toc">
      <li><span class="ch">I</span><span><span class="t">Resort hotel guides</span><span class="d">Walt Disney World, Disneyland and Universal Orlando, room by room.</span></span><span class="st">Polishing</span></li>
      <li><span class="ch">II</span><span><span class="t">Disney Cruise Line ships</span><span class="d">Every ship side by side, so you can pick the right one.</span></span><span class="st">Setting sail</span></li>
      <li><span class="ch">III</span><span><span class="t">First-trip planning</span><span class="d">Budgets, timing and tips, with no insider jargon.</span></span><span class="st">Packing</span></li>
    </ol>
  </section>

  <p class="hint fade d5" id="hint">Tap anywhere in the night sky to <b>make a wish</b>.</p>
  <p class="wishes" id="wishes" aria-live="polite"></p>
</main>

<div class="hills" aria-hidden="true">
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
    <path fill="#1B3263" d="M0 70 C180 30 320 30 480 62 S800 96 980 58 1280 20 1440 50 V120 H0z"/>
    <path fill="#12244A" d="M0 92 C200 62 380 70 560 90 S920 112 1100 84 1340 66 1440 80 V120 H0z"/>
    <path fill="#0C1A36" d="M0 108 C260 94 520 100 760 110 S1200 118 1440 104 V120 H0z"/>
  </svg>
</div>

<footer>
  <p class="sig">See you on park day! <span aria-hidden="true" style="color:var(--gold)">✦</span> Ryan</p>
  <p>Once Upon A Park Day is an independent site. It is not affiliated with, endorsed by, or sponsored by The Walt Disney Company or Universal Orlando Resort.</p>
</footer>

<script>
(function () {
  var canvas = document.getElementById('sky');
  var ctx = canvas.getContext('2d');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var colors = ['#EE7B6F', '#C9A24A', '#F6ECD3', '#FFFFFF', '#F4A79E'];
  var W, H, dpr, stars = [], sparks = [], rockets = [], comets = [];

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var n = Math.round(W * H / 5200);
    stars = [];
    for (var i = 0; i < n; i++) {
      stars.push({ x: Math.random() * W, y: Math.random() * H * 0.92, r: Math.random() * 1.3 + 0.3,
        p: Math.random() * Math.PI * 2, s: 0.6 + Math.random() * 1.8, gold: Math.random() < 0.12 });
    }
    if (reduce) draw(0);
  }

  function burst(x, y, big) {
    var count = big ? 90 : 60;
    var c1 = colors[Math.floor(Math.random() * colors.length)];
    var c2 = colors[Math.floor(Math.random() * colors.length)];
    for (var i = 0; i < count; i++) {
      var a = (i / count) * Math.PI * 2 + Math.random() * 0.2;
      var v = (big ? 3.6 : 2.8) * (0.55 + Math.random() * 0.6);
      sparks.push({ x: x, y: y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 1,
        decay: 0.011 + Math.random() * 0.012, c: i % 2 ? c1 : c2, r: 1.4 + Math.random() * 1.4 });
    }
  }

  function launch(tx, ty) {
    var sx = tx + (Math.random() - 0.5) * 120;
    rockets.push({ x: sx, y: H + 10, tx: tx, ty: ty, vx: (tx - sx) / 48, vy: (ty - H - 10) / 48, t: 0 });
  }

  function comet() {
    comets.push({ x: Math.random() * W * 0.7 + W * 0.2, y: Math.random() * H * 0.3, vx: -(5 + Math.random() * 4), vy: 2.2 + Math.random() * 1.6, life: 1 });
  }

  function draw(t) {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      var a = reduce ? 0.7 : 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(t / 1000 * s.s + s.p));
      ctx.globalAlpha = a;
      ctx.fillStyle = s.gold ? '#E9CF8E' : '#FFFFFF';
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;
    if (reduce) return;

    for (i = comets.length - 1; i >= 0; i--) {
      var c = comets[i];
      c.x += c.vx; c.y += c.vy; c.life -= 0.012;
      var g = ctx.createLinearGradient(c.x, c.y, c.x - c.vx * 14, c.y - c.vy * 14);
      g.addColorStop(0, 'rgba(255,255,255,' + Math.max(c.life, 0) + ')');
      g.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.strokeStyle = g; ctx.lineWidth = 2; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(c.x, c.y); ctx.lineTo(c.x - c.vx * 14, c.y - c.vy * 14); ctx.stroke();
      if (c.life <= 0) comets.splice(i, 1);
    }

    for (i = rockets.length - 1; i >= 0; i--) {
      var r = rockets[i];
      r.x += r.vx; r.y += r.vy; r.t++;
      ctx.fillStyle = '#F6ECD3';
      ctx.beginPath(); ctx.arc(r.x, r.y, 2.2, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(201,162,74,.5)';
      ctx.beginPath(); ctx.arc(r.x - r.vx * 2, r.y - r.vy * 2, 1.6, 0, Math.PI * 2); ctx.fill();
      if (r.t >= 48) { burst(r.tx, r.ty, Math.random() < 0.3); rockets.splice(i, 1); }
    }

    for (i = sparks.length - 1; i >= 0; i--) {
      var p = sparks[i];
      p.vx *= 0.985; p.vy = p.vy * 0.985 + 0.035;
      p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if (p.life <= 0) { sparks.splice(i, 1); continue; }
      ctx.globalAlpha = p.life;
      ctx.fillStyle = p.c;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (0.6 + p.life * 0.6), 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function loop(t) {
    if (!document.hidden && Math.random() < 0.004) comet();
    draw(t);
    requestAnimationFrame(loop);
  }

  var wishes = 0;
  var lines = [
    'One wish made. The pixie dust is settling.',
    'Two wishes! Now we are getting somewhere.',
    'Three wishes. That is the traditional limit, but we will allow it.',
    'Still wishing? Chapter one must be worth the wait.'
  ];
  var wishEl = document.getElementById('wishes');
  window.addEventListener('pointerdown', function (e) {
    if (e.target.closest && e.target.closest('a, button, .book')) return;
    if (reduce) return;
    launch(e.clientX, Math.min(e.clientY, H * 0.75));
    wishes++;
    wishEl.textContent = lines[Math.min(wishes, lines.length) - 1];
    wishEl.classList.add('on');
  });

  window.addEventListener('resize', resize);
  resize();
  if (reduce) {
    document.getElementById('hint').textContent = 'Chapter one is on its way. Check back soon.';
  } else {
    requestAnimationFrame(loop);
    // A little opening show.
    setTimeout(function () { launch(W * 0.22, H * 0.24); }, 900);
    setTimeout(function () { launch(W * 0.78, H * 0.2); }, 1500);
    setTimeout(function () { launch(W * 0.5, H * 0.14); }, 2200);
  }
})();
</script>
</body>
</html>
